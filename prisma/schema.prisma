generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// ============================================================
// AUTH
// ============================================================

enum Role {
  USER
  ADMIN
}

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  emailVerifiedAt DateTime?
  name          String?
  passwordHash  String
  role          Role             @default(USER)
  firmName      String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  queries          OracleQuery[]
  feedback         OracleFeedback[]
  clients          Client[]
  matters          Matter[]
  documents        Document[]
  timeEntries      TimeEntry[]
  trustAccounts    TrustAccount[]
  voiceTranscripts VoiceTranscript[]
  deadlines        Deadline[]
  signatureRequests SignatureRequest[]
  professional     Professional?

  // Stripe — subscriptions
  stripeCustomerId      String?   @unique
  stripeSubscriptionId  String?   @unique
  stripePriceId         String?
  subscriptionStatus    String?
  subscriptionPeriodEnd DateTime?

  // Stripe Connect — marketplace
  stripeConnectAccountId String?              @unique
  connectOnboarded       Boolean              @default(false)
  marketplacePayments    MarketplacePayment[] @relation("ProfessionalPayments")

  // Onboarding
  onboardedAt          DateTime?
  jurisdiction         String?
  practiceArea         String?
  timeZone             String?
  tosAcceptedAt        DateTime?
  tosVersion           String?
  platformAckAt        DateTime?
  platformAckVersion   String?
}

// ============================================================
// PRACTICE FOUNDATION — Clients, Matters, Documents, Billing
// ============================================================

enum MatterStatus {
  ACTIVE
  ON_HOLD
  CLOSED
}

enum DocumentKind {
  CONTRACT
  LETTER
  COURT_FILING
  EVIDENCE
  INVOICE
  RECEIPT
  ENGAGEMENT_LETTER
  WILL
  OTHER
}

enum TrustTransactionType {
  DEPOSIT
  WITHDRAWAL
  FEE_DRAW
}

model Client {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  name          String
  email         String
  phone         String?
  address       String?
  companyName   String?
  notes         String?

  // AML/KYC
  kycStatus       String    @default("pending") // pending, verified, flagged, expired
  kycVerifiedAt   DateTime?
  kycVerifiedBy   String?   // userId of the person who verified
  kycRiskLevel    String?   // low, medium, high
  kycNotes        String?   @db.Text
  identityDocType String?   // passport, drivers_licence, national_id
  identityDocRef  String?   // document reference number (encrypted at rest)
  sourceOfFunds   String?   // employment, business, investment, inheritance, other
  isPEP           Boolean   @default(false) // Politically Exposed Person

  matters       Matter[]
  documents     Document[]
  trustAccounts TrustAccount[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId])
}

model Matter {
  id                String             @id @default(cuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id])
  clientId          String
  client            Client             @relation(fields: [clientId], references: [id])
  title             String
  matterNumber      String?
  practiceArea      String?
  jurisdiction      String?            // NZ, AU, UK, US, CA
  status            MatterStatus       @default(ACTIVE)
  description       String?
  openedAt          DateTime           @default(now())
  closedAt          DateTime?
  documents         Document[]
  timeEntries       TimeEntry[]
  trustTransactions TrustTransaction[]
  deadlines         Deadline[]
  signatureRequests SignatureRequest[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([userId, matterNumber])
  @@index([userId])
  @@index([clientId])
  @@index([status])
}

model Document {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  matterId  String?
  matter    Matter?      @relation(fields: [matterId], references: [id])
  clientId  String?
  client    Client?      @relation(fields: [clientId], references: [id])
  title     String
  fileName  String
  fileUrl   String
  fileSize  Int
  mimeType  String
  kind              DocumentKind @default(OTHER)
  signatureRequests SignatureRequest[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([userId])
  @@index([matterId])
}

model TimeEntry {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  matterId    String
  matter      Matter   @relation(fields: [matterId], references: [id])
  description String
  minutes     Int
  rateInCents Int
  date        DateTime
  billable    Boolean  @default(true)
  invoiced    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([matterId])
  @@index([date])
}

model TrustAccount {
  id             String             @id @default(cuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id])
  clientId       String
  client         Client             @relation(fields: [clientId], references: [id])
  balanceInCents Int                @default(0)
  currency       String             @default("USD")
  jurisdiction   String             @default("US") // NZ, AU, UK, US, CA — determines trust rules
  transactions   TrustTransaction[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([userId, clientId])
}

model TrustTransaction {
  id             String               @id @default(cuid())
  trustAccountId String
  trustAccount   TrustAccount         @relation(fields: [trustAccountId], references: [id])
  type           TrustTransactionType
  amountInCents  Int
  description    String
  matterId       String?
  matter         Matter?              @relation(fields: [matterId], references: [id])
  createdAt      DateTime             @default(now())

  @@index([trustAccountId, createdAt])
}

// ============================================================
// DEADLINES — Court-rules deadline calendar
// ============================================================

model Deadline {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  matterId     String
  matter       Matter    @relation(fields: [matterId], references: [id])
  title        String
  description  String?
  dueDate      DateTime
  courtRule    String?   // e.g., "FRCP Rule 12(a)(1)(A)" or "NZ High Court Rule 5.25"
  jurisdiction String?   // NZ, AU, UK, US, CA
  status       String    @default("upcoming") // upcoming, due_today, overdue, completed, waived
  priority     String    @default("normal") // low, normal, high, critical
  reminderDays Int       @default(3)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([matterId])
  @@index([dueDate])
  @@index([status])
}

// ============================================================
// E-SIGNATURES — signature request tracking
// ============================================================

model SignatureRequest {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  documentId   String?
  document     Document? @relation(fields: [documentId], references: [id])
  matterId     String?
  matter       Matter?  @relation(fields: [matterId], references: [id])
  title        String
  status       String   @default("draft") // draft, sent, viewed, signed, declined, expired
  signerName   String
  signerEmail  String
  message      String?
  sentAt       DateTime?
  viewedAt     DateTime?
  signedAt     DateTime?
  declinedAt   DateTime?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([matterId])
}

// ============================================================
// MARKETPLACE — Stripe Connect escrow payments
// ============================================================

model MarketplacePayment {
  id                    String    @id @default(cuid())
  payerUserId           String?
  professionalUserId    String
  professional          User      @relation("ProfessionalPayments", fields: [professionalUserId], references: [id])
  stripePaymentIntentId String    @unique
  amountCents           Int
  applicationFeeCents   Int
  currency              String    @default("usd")
  status                String
  description           String?
  matterId              String?
  capturedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([professionalUserId])
  @@index([status])
}

// ============================================================
// MARCO REID VOICE — Whisper dictation
// ============================================================

model VoiceTranscript {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  text       String   @db.Text
  durationMs Int?
  language   String? // detected or specified language
  surface    String? // where the dictation happened: "dashboard", "matter", "email", etc.
  matterId   String? // optional link to matter
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ============================================================
// THE ORACLE — Brain, Memory, and Flywheel
// ============================================================

enum QueryDomain {
  LEGAL
  ACCOUNTING
  CROSS_DOMAIN
  IP
}

enum CitationStatus {
  VERIFIED
  UNVERIFIED
  NOT_FOUND
}

// Every query ever made — the memory
model OracleQuery {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  query          String // The raw question asked
  domain         QueryDomain // Legal, Accounting, Cross-domain, IP
  jurisdiction   String? // US, NZ, AU, UK, or specific state
  context        String? // Matter context, previous queries, etc.
  response       String // Marco's full response
  citations      OracleCitation[]
  feedback       OracleFeedback[]
  matterId       String? // Link to matter if query was in-context
  surface        String? // Where the query was made: document, email, cmd-k, etc.
  responseTimeMs Int? // How long the response took
  createdAt      DateTime         @default(now())

  @@index([userId])
  @@index([domain])
  @@index([createdAt])
  @@index([jurisdiction])
}

// Every citation returned — verified or not
model OracleCitation {
  id           String         @id @default(cuid())
  queryId      String
  query        OracleQuery    @relation(fields: [queryId], references: [id])
  title        String // Case name, statute title, IRS section
  citation     String // Formal citation string
  sourceUrl    String? // Direct link to authoritative source
  sourceDb     String? // CourtListener, IRS.gov, Cornell LII, USPTO, etc.
  status       CitationStatus // VERIFIED, UNVERIFIED, NOT_FOUND
  excerpt      String? // Relevant excerpt from the source
  jurisdiction String? // Jurisdiction of the citation
  dateDecided  String? // Date of case decision or ruling
  wasInserted  Boolean        @default(false) // Did the user insert this into a document?
  wasClicked   Boolean        @default(false) // Did the user click to view full text?
  createdAt    DateTime       @default(now())

  @@index([queryId])
  @@index([status])
  @@index([sourceDb])
}

// User feedback on results — the flywheel learning signal
model OracleFeedback {
  id        String      @id @default(cuid())
  queryId   String
  query     OracleQuery @relation(fields: [queryId], references: [id])
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  rating    Int // 1-5 star rating
  helpful   Boolean? // Was this result helpful?
  accurate  Boolean? // Was this result accurate?
  comment   String? // Free text feedback
  createdAt DateTime    @default(now())

  @@index([queryId])
  @@index([userId])
}

// ============================================================
// DATA SOURCES — what Marco knows about
// ============================================================

model DataSource {
  id          String      @id @default(cuid())
  name        String      @unique // CourtListener, IRS.gov, Cornell LII, etc.
  domain      QueryDomain // What domain this source covers
  baseUrl     String // API endpoint or base URL
  apiKey      String? // API key if required (encrypted in env)
  lastSynced  DateTime? // Last time we pulled data
  recordCount Int         @default(0) // How many records we have
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// ============================================================
// FLYWHEEL ANALYTICS — the learning engine
// ============================================================

// Tracks what queries are most common — informs data priority
model QueryPattern {
  id          String      @id @default(cuid())
  pattern     String // Normalised query pattern
  domain      QueryDomain
  count       Int         @default(1) // How many times this pattern was queried
  avgRating   Float? // Average user rating for this pattern
  lastQueried DateTime    @default(now())
  createdAt   DateTime    @default(now())

  @@unique([pattern, domain])
  @@index([count(sort: Desc)])
}

// ============================================================
// COURTS — pilot requests from court procurement leads
// ============================================================

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  verifiedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model CourtPilotRequest {
  id           String   @id @default(cuid())
  name         String
  role         String
  court        String
  jurisdiction String
  email        String
  phone        String?
  products     String[]
  useCase      String   @db.Text
  status       String   @default("new")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([createdAt(sort: Desc)])
}

// ============================================================
// AUDIT TRAIL — Immutable, tamper-evident, court-admissible
// ============================================================

model AuditEvent {
  id            String   @id @default(cuid())
  userId        String
  clientId      String?
  matterId      String?

  // Event classification
  category      String   // auth, matter, client, document, trust, billing, research, voice, communication, compliance, system
  action        String   // created, updated, deleted, viewed, exported, filed, signed, verified, searched, queried
  resource      String   // The type of resource acted upon (matter, client, document, trust_transaction, etc.)
  resourceId    String?  // The ID of the specific resource

  // What happened
  description   String   // Human-readable description
  details       String?  @db.Text // JSON blob of the full change (before/after for updates)

  // Integrity
  ipAddress     String?
  userAgent     String?
  sessionId     String?

  // Tamper evidence — each event hashes the previous event's hash (chain)
  previousHash  String?  // SHA-256 hash of the previous event in this user's chain
  eventHash     String   // SHA-256 hash of this event's content + previousHash

  // Timestamps
  timestamp     DateTime @default(now())

  // Immutability — these records are NEVER updated or deleted
  // Soft-delete is not available. Events are permanent.

  @@index([userId])
  @@index([clientId])
  @@index([matterId])
  @@index([category])
  @@index([timestamp])
  @@index([userId, clientId])
  @@index([userId, timestamp])
}

// Per-client audit summary — quick access to client's complete history
model ClientAuditSummary {
  id            String   @id @default(cuid())
  userId        String
  clientId      String

  totalEvents   Int      @default(0)
  lastEventAt   DateTime?
  lastEventHash String?  // Latest hash in the chain for this client

  // Categories breakdown
  authEvents      Int @default(0)
  matterEvents    Int @default(0)
  documentEvents  Int @default(0)
  trustEvents     Int @default(0)
  billingEvents   Int @default(0)
  researchEvents  Int @default(0)
  voiceEvents     Int @default(0)
  complianceEvents Int @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, clientId])
  @@index([userId])
}

// ============================================================
// PROFESSIONAL DIRECTORY
// ============================================================

model PracticeArea {
  id            String   @id @default(cuid())
  name          String   @unique
  slug          String   @unique
  description   String?
  jurisdiction  String?
  professionals ProfessionalPracticeArea[]
  proMatters    ProMatter[]
  createdAt     DateTime @default(now())
}

model Professional {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id])
  displayName            String
  slug                   String   @unique
  title                  String?
  bio                    String?  @db.Text
  jurisdiction           String?
  admissionYear          Int?
  headline               String?
  professionalBody       String?
  registrationNumber     String?
  admissionNumber        String?
  admissionJurisdiction  String?
  firmDisplayName        String?
  website                String?
  phone                  String?
  email                  String?
  photoUrl               String?
  officeAddress          String?
  languages              String[]
  hourlyRateCents        Int?
  hourlyRateCurrency     String?
  flatSignoffCents       Int?
  flatSignoffCurrency    String?
  piInsurerName          String?
  acceptingNewMatters    Boolean  @default(true)
  publishedToDirectory  Boolean  @default(false)
  verifiedAt             DateTime?
  practiceAreas          ProfessionalPracticeArea[]
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([publishedToDirectory, verifiedAt])
  @@index([slug])
}

model ProfessionalPracticeArea {
  id               String        @id @default(cuid())
  professionalId   String
  professional     Professional  @relation(fields: [professionalId], references: [id])
  practiceAreaId   String
  practiceArea     PracticeArea  @relation(fields: [practiceAreaId], references: [id])

  @@unique([professionalId, practiceAreaId])
}

// ============================================================
// DOCUMENT GENERATION (PUBLIC) + SIGNOFF
// ============================================================

model DocumentDraft {
  id              String   @id @default(cuid())
  contactEmail    String
  jurisdiction    String?
  situation       String?  @db.Text
  extracted       Json?
  body            String?  @db.Text
  bodyHash        String?
  status          String   @default("READY_FOR_REVIEW")
  signedByUserId         String?
  signedByCredential     String?
  signedByJurisdiction   String?
  signedByName           String?
  signedAt               DateTime?
  ipAddress       String?
  userAgent       String?
  expiresAt       DateTime?
  signoffRequests SignoffRequest[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([contactEmail])
  @@index([createdAt])
}

model SignoffRequest {
  id               String        @id @default(cuid())
  draftId          String
  draft            DocumentDraft @relation(fields: [draftId], references: [id])
  professionalId   String?
  kind             String?
  jurisdiction     String?
  requesterEmail   String?
  requesterNotes   String?
  aiOutput         String?       @db.Text
  outputSha256     String?
  status           String        @default("pending")
  requestedAt      DateTime      @default(now())
  reviewedAt       DateTime?
  reviewerNotes    String?
  rejectionReason  String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([draftId])
  @@index([status])
}

// ============================================================
// EMAIL DIGEST / NEWSLETTER
// ============================================================

model DigestSubscription {
  id              String   @id @default(cuid())
  email           String
  name            String?
  active          Boolean  @default(true)
  frequency       String   @default("weekly")
  jurisdiction    String?
  practiceArea    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([email, frequency], name: "email_frequency")
  @@index([email])
}

// ============================================================
// DATA MIGRATION
// ============================================================

enum MigrationSourceSystem {
  CLIO
  LEAP
  ACTIONSTEP
  XERO
  MYOB
  QUICKBOOKS
  IRESS
  SMOKEBALL
  PRACTICE_PANTHER
  AFFINITY
  OTHER
}

model MigrationIntake {
  id             String                @id @default(cuid())
  email          String
  fromSystem     MigrationSourceSystem
  firmName       String?
  jurisdiction   String?
  status         String                @default("pending")
  notes          String?               @db.Text
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([email])
  @@index([status])
}

// ============================================================
// FLYWHEEL — Learning events
// ============================================================

enum LearningEventKind {
  QUERY
  AI_QUERY
  CITATION
  FEEDBACK
  AI_FEEDBACK
  INTERACTION
  ERROR
  PERFORMANCE
  USAGE
  CONVERSION
  SYSTEM
  REGULATORY
  WORKFLOW
  LETTER
}

enum LearningEventSeverity {
  INFO
  POSITIVE
  NEGATIVE
  WARNING
  ERROR
  CRITICAL
}

model LearningEvent {
  id                  String                @id @default(cuid())
  kind                LearningEventKind
  severity            LearningEventSeverity @default(INFO)
  source              String?
  surface             String?
  practiceArea        String?
  jurisdiction        String?
  marcoQueryId        String?
  marcoFeedbackId     String?
  signoffRequestId    String?
  proMatterId         String?
  voiceTranscriptId   String?
  regulatoryUpdateId  String?
  scoreDelta          Float?
  payload             Json?
  userId              String?
  createdAt           DateTime              @default(now())

  @@index([kind])
  @@index([createdAt])
  @@index([userId])
}

// ============================================================
// REGULATORY UPDATES + PRO MATTERS
// ============================================================

model RegulatoryUpdate {
  id            String   @id @default(cuid())
  jurisdiction  String
  regime        String?
  citation      String?
  title         String
  summary       String?  @db.Text
  effectiveAt   DateTime?
  sourceUrl     String?
  practiceAreas String[]
  severity      String   @default("INFO")
  createdAt     DateTime @default(now())

  @@index([jurisdiction])
  @@index([createdAt])
}

model ProMatter {
  id              String        @id @default(cuid())
  userId          String?
  clientEmail     String?
  jurisdiction    String?
  status          String        @default("AWAITING_PRO")
  practiceAreaId  String?
  practiceArea    PracticeArea? @relation(fields: [practiceAreaId], references: [id])
  title           String?
  description     String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([jurisdiction])
  @@index([practiceAreaId])
}
